# Copy to learning-platform-data/.env.oracle-overview (already ignored by Git).
# Get a TLS (not mTLS/JDBC) connection string in Oracle Cloud -> Database connection.
# IMPORTANT: Use placeholders below; never commit real passwords.
ORACLE_USER=LEARNING_PLATFORM
ORACLE_PASSWORD=your_password_here
ORACLE_DSN=(description=(address=(protocol=tcps)(port=1521)(host=your-adb-host.oraclecloud.com))(connect_data=(service_name=your_db_low.adb.oraclecloud.com))(security=(ssl_server_dn_match=yes)))

# Optional when connecting with a separate user granted privileges on tables:
# ORACLE_SCHEMA=LEARNING_PLATFORM
